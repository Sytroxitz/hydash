@page "/admin"

@attribute [Authorize(Roles = "Administrator")]
@layout AdminLayout
@rendermode RenderMode.InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using hydash.WebApp.Data
@using hydash.WebApp.Components.Account

@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<PageTitle>Dashboard — Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-6">Dashboard</MudText>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <MudGrid Spacing="4">
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-5" Elevation="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Style="font-size:2.5rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h3" Style="font-weight:700;">@_totalUsers</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Users</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudPaper Class="pa-5" Elevation="3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Secondary" Style="font-size:2.5rem;" />
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.h3" Style="font-weight:700;">@_totalRoles</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Total Roles</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-8 mb-4">
        <MudText Typo="Typo.h5">Recent Users</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Href="/admin/users" EndIcon="@Icons.Material.Filled.ArrowForward">
            View All
        </MudButton>
    </MudStack>

    <MudTable Items="_recentUsers" Hover="true" Elevation="2" Dense="true">
        <HeaderContent>
            <MudTh></MudTh>
            <MudTh>Username</MudTh>
            <MudTh>Email</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd Style="width:48px;">
                @if (context.AvatarImage != null && context.AvatarImage.Length > 0)
                {
                    <img src="data:image/*;base64,@(Convert.ToBase64String(context.AvatarImage))"
                         style="width:32px;height:32px;border-radius:50%;object-fit:cover;" />
                }
                else
                {
                    <img src="/images/default_avatar.png" style="width:32px;height:32px;border-radius:50%;" />
                }
            </MudTd>
            <MudTd>@context.UserName</MudTd>
            <MudTd>@context.Email</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loading = true;
    private int _totalUsers;
    private int _totalRoles;
    private List<ApplicationUser> _recentUsers = new();

    protected override async Task OnInitializedAsync()
    {
        await using var context = await DbContextFactory.CreateDbContextAsync();
        _totalUsers = await context.Users.CountAsync();
        _totalRoles = await context.Roles.CountAsync();
        _recentUsers = await context.Users.Take(5).ToListAsync();
        _loading = false;
    }
}