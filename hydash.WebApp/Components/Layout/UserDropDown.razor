@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using hydash.WebApp.Components.Account
@using Microsoft.AspNetCore.Components
@using hydash.WebApp.Data
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Authorization
@using MudBlazor

@rendermode RenderMode.InteractiveServer

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IDbContextFactory<ApplicationDbContext> DbContextFactory

<MudMenu AnchorOrigin="Origin.BottomRight"
         TransformOrigin="Origin.TopRight"
         PopoverClass="user-menu-popover"
         ListClass="pa-0">
    <ActivatorContent>
        <div class="user-pill">
            <img src="@AvatarSrc" alt="Avatar" class="user-pill-avatar" />
            <span class="user-pill-name">@(user?.UserName)</span>
            <MudIcon Icon="@Icons.Material.Rounded.ExpandMore" Size="Size.Small" Class="user-pill-caret" />
        </div>
    </ActivatorContent>
    <ChildContent>
        <div class="user-menu">
            <div class="user-menu-head">
                <img src="@AvatarSrc" alt="Avatar" class="user-menu-avatar" />
                <div class="user-menu-id">
                    <span class="user-menu-name">@(user?.UserName)</span>
                    <span class="user-menu-email">@(user?.Email)</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(roleName))
            {
                <span class="user-menu-role" style="@RoleStyle">@roleName</span>
            }

            <div class="user-menu-divider"></div>

            <a class="user-menu-item" href="Account/Manage">
                <MudIcon Icon="@Icons.Material.Outlined.ManageAccounts" Size="Size.Small" />
                <span>Profile</span>
            </a>
            @if (_isAdmin)
            {
                <a class="user-menu-item" href="/admin">
                    <MudIcon Icon="@Icons.Material.Outlined.Dashboard" Size="Size.Small" />
                    <span>Admin Panel</span>
                </a>
            }
            <a class="user-menu-item" href="#">
                <MudIcon Icon="@Icons.Material.Outlined.HelpOutline" Size="Size.Small" />
                <span>Help</span>
            </a>

            <div class="user-menu-divider"></div>

            @* Submits the statically-rendered #hydash-logout-form in NavAppBar
               (which carries a valid antiforgery token). *@
            <button type="submit" form="hydash-logout-form" class="user-menu-item user-menu-logout">
                <MudIcon Icon="@Icons.Material.Outlined.Logout" Size="Size.Small" />
                <span>Log out</span>
            </button>
        </div>
    </ChildContent>
</MudMenu>

@code {
    private ApplicationUser? user;
    private string? roleName;
    private string? roleColor;
    private bool _isAdmin;

    private string AvatarSrc =>
        (user?.AvatarImage is { Length: > 0 } img)
            ? $"data:image/*;base64,{Convert.ToBase64String(img)}"
            : "/images/default_avatar.png";

    private string RoleStyle =>
        string.IsNullOrEmpty(roleColor)
            ? string.Empty
            : $"color:{roleColor}; border-color:{roleColor}66; background:{roleColor}1a;";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claimsPrincipal = authState.User;

        if (!(claimsPrincipal.Identity?.IsAuthenticated ?? false))
        {
            return;
        }

        // Matches the [Authorize(Roles = "Administrator")] guard on the admin pages.
        _isAdmin = claimsPrincipal.IsInRole("Administrator");

        var userId = claimsPrincipal.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (userId is null)
        {
            return;
        }

        // Use a short-lived context from the factory so we never share the
        // scoped Identity DbContext with the page being navigated to.
        await using var context = await DbContextFactory.CreateDbContextAsync();

        user = await context.Users
            .AsNoTracking()
            .FirstOrDefaultAsync(u => u.Id == userId);

        var roleIds = await context.UserRoles
            .Where(ur => ur.UserId == userId)
            .Select(ur => ur.RoleId)
            .ToListAsync();

        if (roleIds.Count > 0)
        {
            var role = await context.Roles
                .AsNoTracking()
                .Where(r => roleIds.Contains(r.Id))
                .OrderByDescending(r => r.Priority)
                .FirstOrDefaultAsync();

            roleName = role?.Name ?? "Member";
            roleColor = role?.ColorCode;
        }
        else
        {
            roleName = "Member";
        }
    }
}