@inherits LayoutComponentBase
@layout AccountLayout

<div class="manage-page">
    <div class="manage-header hy-anim-up">
        <h1 class="manage-title">Account settings</h1>
        <p class="manage-subtitle">Manage your profile, security and personal data.</p>
    </div>

    <div class="manage-shell">
        <aside class="manage-nav hy-glass hy-anim-up hy-delay-1">
            <ManageNavMenu />
        </aside>
        <section class="manage-content hy-glass hy-anim-up hy-delay-2">
            @Body
        </section>
    </div>
</div>
