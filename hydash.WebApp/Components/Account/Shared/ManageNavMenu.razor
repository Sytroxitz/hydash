@using Microsoft.AspNetCore.Identity
@using hydash.WebApp.Data

@inject SignInManager<ApplicationUser> SignInManager

<nav class="manage-nav-list">
    <NavLink class="manage-nav-link" href="Account/Manage" Match="NavLinkMatch.All">
        <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" />
        <span>Profile</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/Email">
        <MudIcon Icon="@Icons.Material.Outlined.Email" Size="Size.Small" />
        <span>Email</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/ChangePassword">
        <MudIcon Icon="@Icons.Material.Outlined.Password" Size="Size.Small" />
        <span>Password</span>
    </NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="manage-nav-link" href="Account/Manage/ExternalLogins">
            <MudIcon Icon="@Icons.Material.Outlined.Link" Size="Size.Small" />
            <span>External logins</span>
        </NavLink>
    }
    <NavLink class="manage-nav-link" href="Account/Manage/TwoFactorAuthentication">
        <MudIcon Icon="@Icons.Material.Outlined.Security" Size="Size.Small" />
        <span>Two-factor authentication</span>
    </NavLink>
    <NavLink class="manage-nav-link" href="Account/Manage/PersonalData">
        <MudIcon Icon="@Icons.Material.Outlined.Shield" Size="Size.Small" />
        <span>Personal data</span>
    </NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
