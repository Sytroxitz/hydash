{
  "hydash": {
    "DefaultAdminEmail": "admin@example.com"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_DB_HOST;Port=3306;Database=hydash;Uid=YOUR_DB_USER;Pwd=YOUR_DB_PASSWORD;",
    "DevConnection": "Server=localhost;Port=3306;Database=hydash;Uid=YOUR_DB_USER;Pwd=YOUR_DB_PASSWORD;"
  },
  "Authentication": {
    "Google": {
      "ClientId": "your-client-id",
      "ClientSecret": "your-client-secret"
    }
  },
  "ApiUrl": "https://localhost:5002",
  "JwtBearer": {
    "Authority": "https://localhost:5002",
    "Audience": "api1"
  }
}
